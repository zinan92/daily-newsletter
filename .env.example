# Daily Newsletter settings.
# Copy this file to .env (same folder) and fill in what you have:
#   cp .env.example .env
# .env is git-ignored. Real environment variables win over values in .env.
# Lines left empty are ignored.

# ── 1. Where your data lives ──────────────────────────────────────────────────
# Raw downloads, processed batches and the final daily all go under here.
# The finished daily: $PARKIO_HOME/006_ai daily newsletter/<YY-MM-DD>.md
PARKIO_HOME=~/park-io

# Source list. Empty = the full list shipped in this repo (sources.md).
PARKIO_SOURCES=

# ── 2. The AI that reads and writes the daily (pick ONE provider) ─────────────
# API providers:  deepseek | anthropic
# CLI providers:  claude   (Claude Code, logged in with `claude`)
#                 codex    (OpenAI Codex CLI, logged in with `codex login`)
PARKIO_LLM_PROVIDER=deepseek

# deepseek → https://platform.deepseek.com/api_keys
PARKIO_DEEPSEEK_KEY=
# Any OpenAI-compatible /chat/completions endpoint also works through these two:
PARKIO_DEEPSEEK_ENDPOINT=
PARKIO_DEEPSEEK_MODEL=

# anthropic → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Empty = claude-sonnet-5-5
PARKIO_ANTHROPIC_MODEL=

# claude CLI: empty = Claude Code's own default model
PARKIO_CLAUDE_MODEL=

# codex CLI: "default" = the CLI's own default model
PARKIO_CODEX_MODEL=default

# Backup provider when the main one is down or out of credit (same names as
# above, or none). Out of the box this is codex when the main one is deepseek;
# set none if you don't have the Codex CLI.
PARKIO_LLM_FALLBACK_PROVIDER=none

# ── 3. Optional sources (each needs your own login; see README 前置条件) ──────
# X / Twitter: install twitter-cli (`uv tool install twitter-cli`), log in to
# x.com in your browser, then run `python3 refresh-twitter-auth.py`.
PARKIO_TWITTER_BIN=
PARKIO_TWITTER_AUTH_ENV=

# YouTube / podcast video transcription: a Netscape cookies.txt exported from a
# logged-in youtube.com tab. Default: $PARKIO_HOME/_secrets/youtube-cookies.txt
PARKIO_YTDLP_COOKIES_FILE=

# Douyin: put your cookies in $PARKIO_HOME/_secrets/douyin-cookies.json
# (format: vendor/content_downloader/cookies.json.example).

# ── 4. Optional delivery ──────────────────────────────────────────────────────
# Feishu custom bot (with signature). Empty = the daily stays a local file.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
